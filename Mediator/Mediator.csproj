<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Package Information -->
		<PackageId>FiapCloudGaming.Mediator</PackageId>
		<Version>1.0.0</Version>
		<Authors>FIAP Cloud Gaming Team</Authors>
		<Company>FIAP Cloud Gaming</Company>
		<Product>FIAP Cloud Gaming Mediator</Product>
		<Description>Lightweight mediator implementation for CQRS pattern with commands, queries and notifications. Built for .NET 10 microservices architecture.</Description>
		<PackageTags>mediator;cqrs;commands;queries;notifications;domain-events;fiap</PackageTags>
		<PackageProjectUrl>https://github.com/fiap-cloud-gaming/Mediator</PackageProjectUrl>
		<RepositoryUrl>https://github.com/fiap-cloud-gaming/Mediator</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>

		<!-- Build Configuration -->
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>

		<!-- Documentation -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);1591</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" />
		<PackageReference Include="Scrutor" />
	</ItemGroup>
</Project>
